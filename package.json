{
  "name": "rpg-birmingham",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "smoke": "tsx tests/smoke.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.73.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swr": "^2.5.1",
    "three": "^0.160.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.160.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "vitest": "^5.1.0"
  }
}
